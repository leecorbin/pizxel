{
  "name": "pizxel",
  "version": "0.1.0",
  "description": "Retro-aesthetic LED matrix OS - Look like 1983, work like 2025",
  "main": "pizxel/start.ts",
  "scripts": {
    "start": "tsx pizxel/start.ts",
    "start:fb": "tsx pizxel/start.ts --fb",
    "start:canvas": "tsx pizxel/start.ts --canvas",
    "start:term": "tsx pizxel/start.ts --term",
    "start:server": "tsx pizxel/start-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/instance-test.ts && tsx tests/server-test.ts && tsx tests/apps-test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "led-matrix",
    "raspberry-pi",
    "retro",
    "zx-spectrum",
    "embedded"
  ],
  "author": "Lee Corbin",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.0",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "tsx": "^4.20.6",
    "ws": "8.17.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "canvas@3.2.0": true,
    "esbuild@0.25.12": true
  }
}
